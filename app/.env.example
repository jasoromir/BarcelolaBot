# Copy to .env and fill values for local dev.
NODE_ENV=development
HTTP_PORT=3000

# bcrypt hash of your admin password. Generate with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 10))" 'your-password'
ADMIN_PASSWORD_HASH=

# Long random string for signing the admin cookie
SESSION_COOKIE_SECRET=

# Wix
WIX_API_KEY=
WIX_SITE_ID=
WIX_WEBHOOK_SIGNING_SECRET=

# Optional: override data directory (defaults to ./data)
DATA_DIR=./data

# Gemini (classifier/drafter, and private-tour calendar parsing)
GEMINI_API_KEY=

# Google service account for reading the private-tours calendar in production.
# Base64 of the full service-account JSON key (avoids the classic \n-in-
# private_key escaping problem in the Railway variable editor).
# Generate: base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_B64=
